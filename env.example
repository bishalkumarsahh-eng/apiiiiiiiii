# REQUIRED - primary API key
API_KEY=jx_live_change_me

# OPTIONAL - multiple client keys, comma-separated. API_KEY and BOT_API_KEY are also accepted.
API_KEYS=jx_live_client_one,jx_live_client_two

# OPTIONAL - protects /admin/* endpoints
ADMIN_API_KEY=jx_admin_change_me

BASE_URL=
DOWNLOAD_DIR=downloads
DB_FILE=cache.db
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
RATE_LIMIT=60
RATE_WINDOW=60
MAX_SEARCH_RESULTS=20
PUBLIC_HEALTH=true
CONCURRENT_FRAGMENT_DOWNLOADS=10
HTTP_CHUNK_SIZE=10485760
SOCKET_TIMEOUT=20
RETRIES=5
FRAGMENT_RETRIES=5
YOUTUBE_PLAYER_CLIENTS=web_embedded
YOUTUBE_USE_COOKIES=true
COOKIE_URL=
COOKIES_FILE=cookies.txt
