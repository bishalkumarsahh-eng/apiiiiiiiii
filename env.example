API_NAME=Juno X Music API
ADMIN_KEY=PUT_A_LONG_RANDOM_ADMIN_SECRET_HERE
API_DB=/tmp/juno_api.sqlite3
MAX_DURATION=900
MAX_RESULTS=20
DOWNLOAD_TIMEOUT=300

# Optional YouTube authentication cookies (base64-encoded Netscape cookies.txt)
# Never commit this value to GitHub or put it in source code.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES_FILE=/tmp/juno_youtube_cookies.txt
