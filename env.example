API_NAME=Juno X Music API
ADMIN_KEY=PUT_A_LONG_RANDOM_ADMIN_SECRET_HERE
API_DB=/tmp/juno_api.sqlite3
MAX_DURATION=900
MAX_RESULTS=20
DOWNLOAD_TIMEOUT=300
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES_FILE=/tmp/juno_youtube_cookies.txt
# Ordered fallback clients. If YouTube changes, this can be changed without editing code.
YOUTUBE_PLAYER_CLIENTS=web_safari,mweb,tv,android_vr,web_embedded
